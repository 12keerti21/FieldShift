# Copy this file to .env and fill in your keys. .env is gitignored and must never
# be committed. Nothing in src/ holds a credential; everything reads from here.
#
#   cp .env.example .env     then edit .env
#
# Earthdata is NOT here: it uses ~/.netrc instead, because every NASA download
# tool (curl -n, earthaccess, wget) reads that file directly, which means the
# password never has to pass through a command line or an environment variable.

# USDA NASS QuickStats - county yields, our headline validation channel
# get one at https://quickstats.nass.usda.gov/api/
NASS_QUICKSTATS_KEY=

# USGS Water Data - Ogallala groundwater decline (replaces the retired NWIS endpoint)
# get one at https://api.waterdata.usgs.gov/signup/
USGS_WATERDATA_KEY=

# USDA AMS Market News - crop prices; our crop table refuses to invent these
# get one at https://mymarketnews.ams.usda.gov/
AMS_MARKET_NEWS_KEY=

# OpenET - field-scale ET, validation channel 2
# request access at https://openetdata.org/
OPENET_KEY=

# Copernicus Climate Data Store (ERA5) - Tier 2 global forcing
# https://cds.climate.copernicus.eu/how-to-api
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Copernicus Data Space (Sentinel-2)
# https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
